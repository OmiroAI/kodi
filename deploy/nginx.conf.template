map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};
    ssl_certificate /run/tls/server.crt;
    ssl_certificate_key /run/tls/server.key;
    auth_basic "Kodi";
    auth_basic_user_file /run/secrets/dashboard.htpasswd;
    location /setup/github {
        access_log off;
        proxy_pass http://setup:38530;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
    }
    # Kandev 0.97: ticket-only creation must not prepare native agent sessions.
    # Scoped to its content-hashed asset; verify again before upgrading Kandev.
    location = /assets/port-forwarding-visibility-provider-qn9QnhZK.js {
        proxy_pass http://dashboard:38429;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept-Encoding "";
        proxy_set_header If-None-Match "";
        proxy_set_header If-Modified-Since "";
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store";
        sub_filter_types application/javascript text/javascript;
        sub_filter_once on;
        # Expose ticket-only creation on desktop; the native split button needs an agent.
        sub_filter 'className:`w-full cursor-pointer gap-1.5 sm:hidden`,disabled:n,onClick:i,"data-testid":`mobile-create-without-agent`' 'className:`w-full cursor-pointer gap-1.5 sm:w-auto`,disabled:n,onClick:i,"data-testid":`mobile-create-without-agent`';
        sub_filter 'r=zg(e)||n,i=r||!e.agentProfileId,a=!e.agentProfileId||e.noCompatibleAgent;return{showStartTask:t,splitDisabled:i,altDisabled:r,defaultDisabled:(e.isSessionMode?a:r)||n' 'r=zg({...e,noCompatibleAgent:!1})||n,i=r||!e.agentProfileId||e.noCompatibleAgent,a=!e.agentProfileId||e.noCompatibleAgent;return{showStartTask:t,splitDisabled:i,altDisabled:r,defaultDisabled:(e.isSessionMode?a:r||e.noCompatibleAgent)||n';
        sub_filter 'e.effectiveWorkflowId&&e.agentProfileId&&n' 'e.effectiveWorkflowId&&(e.withAgent===!1||e.agentProfileId)&&n';
        sub_filter 'je=(0,J.useCallback)((e,t=``)=>_E({' 'je=(0,J.useCallback)((e,t=``,a=!0)=>_E({withAgent:a,';
        sub_filter 'if(!je(e,t))return;let l={description:t' 'if(!je(e,t,!1))return;let l={description:t';
        sub_filter '...pE(e),description:e.trimmedDescription,repositories:e.repositoriesPayload,...mE(e.withAgent),...hE(e),priority:' '...(!e.withAgent&&!e.planMode?{title:e.trimmedTitle||e.trimmedDescription.split(String.fromCharCode(10))[0].slice(0,60)}:pE(e)),description:e.trimmedDescription,repositories:e.repositoriesPayload,...(!e.withAgent&&!e.planMode?{state:`CREATED`,start_agent:!1,prepare_session:!1}:mE(e.withAgent)),...hE(e),...(!e.withAgent&&!e.planMode?{autopilot:!1,agent_profile_id:void 0,executor_id:void 0,executor_profile_id:void 0}:{}),priority:';
    }
    location / {
        proxy_pass http://dashboard:38429;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
