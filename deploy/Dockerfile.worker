FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
ARG CODEX_VERSION=0.162.1
ARG GEMINI_VERSION=0.63.0
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git socat ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@${CODEX_VERSION} @google/gemini-cli@${GEMINI_VERSION}
# Native Linux x86_64 release, pinned and verified against Google's release manifest.
ARG ANTIGRAVITY_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.3.3-5524738307653632/linux-x64/cli_linux_x64.tar.gz
ARG ANTIGRAVITY_SHA512=abe3ddf5cf30d3adaa586acf505221aa19702f5ca71af3c8b1f9b1a5976bd8e5c151c41ea33b39c41675d25843462a3e8c382c054f580e9d7e1688919d3b5110
RUN test "$(uname -m)" = x86_64 && curl -fsSL "$ANTIGRAVITY_URL" -o /tmp/agy.tar.gz && \
    printf '%s  /tmp/agy.tar.gz\n' "$ANTIGRAVITY_SHA512" | sha512sum -c - && \
    tar -xzf /tmp/agy.tar.gz -C /usr/local/bin antigravity && \
    mv /usr/local/bin/antigravity /usr/local/bin/agy && chmod 755 /usr/local/bin/agy && rm /tmp/agy.tar.gz
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" HOME=/home/worker CODEX_HOME=/home/worker/.codex
COPY worker-entrypoint.sh /usr/local/bin/kodi-entrypoint
RUN chmod 755 /usr/local/bin/kodi-entrypoint && mkdir -p /home/worker /workspace && chown -R 1000:1000 /home/worker /opt/venv /workspace
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["kodi-entrypoint"]
